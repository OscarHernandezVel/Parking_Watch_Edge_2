# Configuración del Edge (/etc/cupo-edge/edge.env, propietario root, permisos 600).
CAMERA_ID=CAM-MAQ-01
# Backend en Render: todas las conexiones salen del Edge (HTTPS y WSS), sin puertos abiertos.
BACKEND_URL=https://api.cupo-transito.co
DEVICE_TOKEN=pwd_reemplace-por-el-token-de-la-camara
AGENT_MODE=CAMERA
# rpicam = Camera Module 3 Wide; o la ruta de un video grabado de la maqueta para pruebas.
VIDEO_URL=rpicam
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=15
# Exposición y balance de blancos fijos (calibrar con la lámpara de la maqueta).
CAMERA_SHUTTER_US=10000
CAMERA_GAIN=1.0
CAMERA_AWB_GAINS=1.8,1.5
MODEL_VERSION=det-1.0-maqueta
DETECTOR_MODEL=/var/lib/cupo-edge/models/det-1.0-maqueta/detector.onnx
PLATE_MODEL=/var/lib/cupo-edge/models/plates/plate-ocr.onnx
CLASS_MAPPING=PROTOTYPE
# Búfer local SQLite (outbox.db) para cortes de internet de hasta 24 horas.
DATA_DIR=/var/lib/cupo-edge/data
MODELS_DIR=/var/lib/cupo-edge/models
HEALTH_PORT=8090
MOTION_THRESHOLD_PX=6
